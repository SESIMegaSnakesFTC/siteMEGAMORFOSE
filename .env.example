# Preencha para ativar o backend Supabase. Sem estas variáveis, a plataforma roda em
# "modo demonstração" com dados salvos apenas no navegador (localStorage).
# A chave "anon" é pública por design; a segurança vem das políticas RLS (supabase/schema.sql).
# NUNCA coloque a chave service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# "hash" para hospedagem estática sem reescrita de rotas (ex.: GitHub Pages)
VITE_ROUTER=browser
